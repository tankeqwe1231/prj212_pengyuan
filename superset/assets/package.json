{
  "name": "superset",
  "version": "0.23.0dev",
  "description": "Superset is a data exploration platform designed to be visual, intuitive, and interactive.",
  "license": "Apache-2.0",
  "directories": {
    "doc": "docs",
    "test": "spec"
  },
  "scripts": {
    "test": "cross-env BABEL_ENV=test mocha --require @babel/register --require ignore-styles --require spec/helpers/browser.js --recursive \"spec/**/*_spec.{js,jsx}\"",
    "cover": "nyc npm test",
    "dev": "webpack --mode development --watch --progress --devtool eval-cheap-module-source-map",
    "dev-slow": "webpack --mode development --watch --progress --devtool inline-source-map",
    "dev-fast": "echo 'dev-fast in now replaced by dev'",
    "prod": "webpack --mode production --progress",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 webpack --mode production --progress",
    "lint": "eslint --ignore-path=.eslintignore --ext .js,.jsx .",
    "lint-fix": "eslint --fix --ignore-path=.eslintignore --ext .js,.jsx .",
    "sync-backend": "cross-env BABEL_ENV=test node --require @babel/register javascripts/syncBackend.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apache/incubator-superset.git"
  },
  "keywords": [
    "big",
    "data",
    "exploratory",
    "analysis",
    "react",
    "d3",
    "airbnb",
    "nerds",
    "database",
    "flask"
  ],
  "author": "Apache",
